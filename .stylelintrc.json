{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "at-rule-no-unknown": null,
    "selector-class-pattern": null,
    "scss/comment-no-empty": null,
    "no-descending-specificity": null
  },
  "ignoreFiles": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/themes/custom/denbei/**",
    "**/themes/custom/shindo/assets/css/**",
    "**/themes/custom/shindo/assets/sass/libs/**",
    "**/themes/custom/shindo/assets/sass/main.scss",
    "**/themes/custom/shindo/assets/dopetrope/**"
  ]
}
