<?xml version="1.0" encoding="UTF-8"?>
<!-- AI generated -->
<ruleset name="doesdesign"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                             http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>PHPMD rules for custom code in doesdesign.</description>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/denbei/*</exclude-pattern>

    <rule ref="rulesets/cleancode.xml">
        <!-- Drupal has legitimate uses of `else` in preprocess/hook code. -->
        <exclude name="ElseExpression"/>
        <!-- Boolean args frequent in Drupal hooks/plugins. -->
        <exclude name="BooleanArgumentFlag"/>
        <!-- Drupal factory methods commonly use static access. -->
        <exclude name="StaticAccess"/>
        <!-- Drupal coder forbids `use` on non-namespaced SPL classes,
             so \ArrayIterator etc. must be referenced inline. -->
        <exclude name="MissingImport"/>
    </rule>

    <rule ref="rulesets/codesize.xml">
        <!-- Drupal preprocess hooks routinely have many locals. -->
        <exclude name="ExcessiveMethodLength"/>
    </rule>

    <rule ref="rulesets/controversial.xml">
        <!-- Camel-case rule conflicts with Drupal's snake_case hook names. -->
        <exclude name="CamelCaseMethodName"/>
        <exclude name="CamelCaseParameterName"/>
        <exclude name="CamelCaseVariableName"/>
    </rule>

    <rule ref="rulesets/design.xml"/>

    <rule ref="rulesets/naming.xml">
        <!-- Short variable names are fine in short scopes. -->
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>

    <rule ref="rulesets/unusedcode.xml">
        <!-- Drupal signature-required unused parameters. -->
        <exclude name="UnusedFormalParameter"/>
    </rule>

</ruleset>
