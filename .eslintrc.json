{
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true
  },
  "extends": ["eslint:recommended"],
  "globals": {
    "Drupal": "readonly",
    "drupalSettings": "readonly",
    "jQuery": "readonly",
    "once": "readonly",
    "Splide": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "**/vendor/**",
    "**/node_modules/**",
    "web/themes/custom/denbei/**",
    "**/*.min.js",
    "web/themes/custom/shindo/assets/dopetrope/**",
    "web/themes/custom/shindo/assets/js/main.js",
    "web/themes/custom/shindo/assets/js/util.js",
    "web/themes/custom/shindo/assets/js/breakpoints.min.js",
    "web/themes/custom/shindo/assets/js/browser.min.js",
    "web/themes/custom/shindo/assets/js/jquery.min.js",
    "web/themes/custom/shindo/assets/js/jquery.dropotron.min.js"
  ]
}
