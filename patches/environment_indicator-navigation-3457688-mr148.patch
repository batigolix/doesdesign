 use Drupal\user\Entity\Role;
 
+/**
+ * Implements hook_install().
+ */
+function environment_indicator_install() {
+  _environment_indicator_enable_navigation_submodule_if_required();
+}
+
+/**
+ * Enables the environment_indicator_navigation submodule if required.
+ *
+ * If the 'navigation' module is enabled and the 'toolbar' module is not,
+ * the 'environment_indicator_navigation' submodule is installed so sites
+ * using the core Navigation module get the integration without a manual
+ * step. When both 'toolbar' and 'navigation' are enabled, no change is made
+ * so an existing toolbar integration is left as-is.
+ *
+ * Used on install for new sites, and from
+ * environment_indicator_update_8104() for existing sites where 'navigation'
+ * is already enabled.
+ */
+function _environment_indicator_enable_navigation_submodule_if_required() {
+  $module_handler = \Drupal::service('module_handler');
+  if (!$module_handler->moduleExists('navigation') || $module_handler->moduleExists('toolbar')) {
+    return;
+  }
+  if (!$module_handler->moduleExists('environment_indicator_navigation')) {
+    \Drupal::service('module_installer')->install(['environment_indicator_navigation']);
+  }
+}
+
 /**
  * Initialize the version_identifier and version_identifier_fallback settings.
  */
@@ -81,3 +111,23 @@ function environment_indicator_update_8103() {
     $settings->save();
   }
 }
+
+/**
+ * Enable the environment_indicator_navigation submodule if required.
+ *
+ * Also removes the toolbar_integration setting if it is still present.
+ * environment_indicator_update_8103() only cleared it when the 'toolbar'
+ * module was enabled at the time it ran, so sites that ran that update
+ * without 'toolbar' enabled were left with this obsolete, no-longer
+ * schema-defined key.
+ *
+ * @see _environment_indicator_enable_navigation_submodule_if_required()
+ */
+function environment_indicator_update_8104() {
+  _environment_indicator_enable_navigation_submodule_if_required();
+
+  $settings = \Drupal::configFactory()->getEditable('environment_indicator.settings');
+  if ($settings->get('toolbar_integration') !== NULL) {
+    $settings->clear('toolbar_integration')->save();
+  }
+}
