diff --git a/tests/src/Kernel/EnvironmentIndicatorInstallTest.php b/tests/src/Kernel/EnvironmentIndicatorInstallTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..1651012b296348c80a2778c8f7ff92d33ee5ef36
--- /dev/null
+++ b/tests/src/Kernel/EnvironmentIndicatorInstallTest.php
@@ -0,0 +1,78 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\environment_indicator\Kernel;
+
+use Drupal\KernelTests\KernelTestBase;
+
+/**
+ * Tests automatic enabling of the navigation submodule on install.
+ *
+ * @group environment_indicator
+ */
+class EnvironmentIndicatorInstallTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+  ];
+
+  /**
+   * Tests that the navigation submodule is enabled when navigation is on.
+   */
+  public function testNavigationSubmoduleEnabledWhenNavigationEnabled(): void {
+    \Drupal::service('module_installer')->install(['navigation']);
+    \Drupal::service('module_installer')->install(['environment_indicator']);
+
+    $module_handler = \Drupal::service('module_handler');
+    $this->assertTrue($module_handler->moduleExists('environment_indicator_navigation'));
+  }
+
+  /**
+   * Tests that nothing changes when both toolbar and navigation are on.
+   */
+  public function testNoChangeWhenToolbarAndNavigationEnabled(): void {
+    \Drupal::service('module_installer')->install(['toolbar', 'navigation']);
+    \Drupal::service('module_installer')->install(['environment_indicator']);
+
+    $module_handler = \Drupal::service('module_handler');
+    $this->assertFalse($module_handler->moduleExists('environment_indicator_navigation'));
+  }
+
+  /**
+   * Tests that nothing is enabled when neither toolbar nor navigation is on.
+   */
+  public function testNoSubmoduleEnabledWithoutNavigation(): void {
+    \Drupal::service('module_installer')->install(['environment_indicator']);
+
+    $module_handler = \Drupal::service('module_handler');
+    $this->assertFalse($module_handler->moduleExists('environment_indicator_navigation'));
+    $this->assertFalse($module_handler->moduleExists('environment_indicator_toolbar'));
+  }
+
+  /**
+   * Tests that update 8104 removes a leftover toolbar_integration setting.
+   */
+  public function testUpdate8104RemovesStaleToolbarIntegrationSetting(): void {
+    \Drupal::service('module_installer')->install(['environment_indicator']);
+
+    // Write the obsolete key directly to storage, bypassing the config
+    // schema checker, since it no longer exists in the schema.
+    $storage = \Drupal::service('config.storage');
+    $data = $storage->read('environment_indicator.settings');
+    $data['toolbar_integration'] = ['toolbar'];
+    $storage->write('environment_indicator.settings', $data);
+    \Drupal::configFactory()->reset('environment_indicator.settings');
+
+    \Drupal::moduleHandler()->loadInclude('environment_indicator', 'install');
+    environment_indicator_update_8104();
+
+    $settings = \Drupal::configFactory()->get('environment_indicator.settings');
+    $this->assertNull($settings->get('toolbar_integration'));
+  }
+
+}
