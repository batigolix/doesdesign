+    $this->assertArrayHasKey('environment_indicator', $result['#items']);
+    $this->assertEquals('Production Environment', $result['#items']['environment_indicator']['title']);
+    $this->assertEquals($switchers, $result['#items']['environment_indicator']['switchers']);
+    $this->assertEquals('production', $result['#items']['environment_indicator']['class']);
