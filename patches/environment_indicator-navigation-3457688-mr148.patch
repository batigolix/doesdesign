new file mode 100644
index 0000000000000000000000000000000000000000..a66f98041d3061a497df14a89bc1b937bae90666
--- /dev/null
+++ b/modules/environment_indicator_navigation/environment_indicator_navigation.module
@@ -0,0 +1,116 @@
+<?php
+
+/**
+ * @file
+ * Provides integration for the Environment Indicator with Navigation.
+ */
+
+use Drupal\Core\Access\AccessResult;
+use Drupal\Core\Cache\Cache;
+
+/**
+ * Implements hook_navigation_content_top().
+ */
+function environment_indicator_navigation_navigation_content_top(): array {
+  if (!\Drupal::currentUser()->hasPermission('access environment indicator')) {
+    return [];
+  }
+  $environment_indicator = \Drupal::service('environment_indicator.indicator');
+  $active_environment = $environment_indicator->getActiveEnvironment();
+  $account = \Drupal::currentUser();
+  $access = AccessResult::allowedIfHasPermission($account, 'access environment indicator')
+    ->andIf(AccessResult::allowedIf(!empty($active_environment->get('name'))));
+
+  return [
+    'environment_indicator_wrapper' => [
+      '#access' => $access,
+      'environment_indicator' => [
+        '#lazy_builder' => ['environment_indicator_navigation.lazy_builder:getSwitcherLinks', []],
+        '#create_placeholder' => TRUE,
+        '#cache' => [
+          'keys' => ['environment_indicator_navigation_links'],
+          'contexts' => ['user.permissions', 'route'],
+          'tags' => Cache::mergeTags([
+            'config:environment_indicator.settings',
+            'config:environment_indicator.indicator',
+          ], $environment_indicator->getCacheTags()),
+        ],
+        '#lazy_builder_preview' => [
+          '#theme' => 'navigation_menu__environment_indicator_navigation',
+          '#menu_name' => 'environment_indicator_navigation',
+          '#items' => [
+            'environment_indicator' => [
+              'title' => $environment_indicator->getTitle(),
+              'switchers' => [],
+              'class' => $active_environment->get('name'),
+            ],
+          ],
+        ],
+      ],
+    ],
+  ];
+}
+
+/**
+ * Implements hook_page_attachments_alter().
+ */
+function environment_indicator_navigation_page_attachments_alter(array &$attachments) {
+  if (!\Drupal::currentUser()->hasPermission('access environment indicator')) {
+    return;
+  }
+
+  $environment_indicator = \Drupal::service('environment_indicator.indicator');
+  $active_environment = $environment_indicator->getActiveEnvironment();
+  $name = $active_environment->get('name');
+  if (empty($name)) {
+    return;
+  }
+
+  // Attach CSS variables for the active environment.
+  $fg_color = $active_environment->get('fg_color');
+  $bg_color = $active_environment->get('bg_color');
+
+  // Get all switcher link styles for proper environment colors.
+  $switcher_styles = $environment_indicator->getAllSwitcherLinkStyles(':is(#extra-specificity-hack, [data-drupal-admin-styles]) .toolbar-popover__menu');
+
+  // Ensure html_head array exists before merging.
+  if (!isset($attachments['#attached']['html_head'])) {
+    $attachments['#attached']['html_head'] = [];
+  }
+
+  // Add the CSS variables.
+  $attachments['#attached']['html_head'][] = [
+    [
+      '#tag' => 'style',
+      '#value' => ":root { --env-indicator-fg-color: $fg_color; --env-indicator-bg-color: $bg_color; }",
+    ],
+    'environment_indicator_navigation_vars',
+  ];
+
+  // Add the switcher link styles.
+  foreach ($switcher_styles as $style) {
+    $attachments['#attached']['html_head'][] = $style;
+  }
+
+  // Add the navigation library.
+  if (!isset($attachments['#attached']['library'])) {
+    $attachments['#attached']['library'] = [];
+  }
+  $attachments['#attached']['library'][] = 'environment_indicator_navigation/navigation';
+}
+
+/**
+ * Implements hook_theme().
+ */
+function environment_indicator_navigation_theme($existing, $type, $theme, $path): array {
+  return [
+    'navigation_menu__environment_indicator_navigation' => [
+      'variables' => [
+        'menu_name' => NULL,
+        'items' => [],
+        'attributes' => [],
+      ],
+      'base hook' => 'navigation_menu',
+    ],
+  ];
+}
