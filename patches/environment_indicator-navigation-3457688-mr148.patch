@@ -0,0 +1,204 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\environment_indicator_navigation\Functional;
+
+use Drupal\Core\Url;
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Tests the navigation integration functionality.
+ *
+ * @group environment_indicator_navigation
+ */
+class NavigationIntegrationTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'environment_indicator',
+    'environment_indicator_navigation',
+    'navigation',
+  ];
+
+  /**
+   * A user with permissions to access the environment indicator.
+   *
+   * @var \Drupal\user\UserInterface
+   */
+  protected $privilegedUser;
+
+  /**
+   * A user without permissions to access the environment indicator.
+   *
+   * @var \Drupal\user\UserInterface
+   */
+  protected $unprivilegedUser;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    // Create a privileged user with access to environment indicator.
+    $this->privilegedUser = $this->drupalCreateUser([
+      'access environment indicator',
+      'access navigation',
+      'access administration pages',
+    ]);
+
+    // Create an unprivileged user without access to environment indicator.
+    $this->unprivilegedUser = $this->drupalCreateUser([
+      'access navigation',
+    ]);
+
+    // Configure an environment indicator.
+    $environment_config = $this->config('environment_indicator.indicator');
+    $environment_config->set('name', 'Test Environment');
+    $environment_config->set('bg_color', '#ff0000');
+    $environment_config->set('fg_color', '#ffffff');
+    $environment_config->save();
+  }
+
+  /**
+   * Tests that navigation content is added for privileged users.
+   */
+  public function testNavigationContentForPrivilegedUser(): void {
+    $this->drupalLogin($this->privilegedUser);
+    $this->drupalGet('<front>');
+
+    // Check that the navigation is present and contains environment indicator.
+    $this->assertSession()->elementExists('css', '.admin-toolbar__item--environment-indicator');
+    $this->assertSession()->pageTextContains('Test Environment');
+  }
+
+  /**
+   * Tests that the configure link respects its route permission.
+   */
+  public function testConfigureLinkAccess(): void {
+    $switcher = \Drupal::entityTypeManager()
+      ->getStorage('environment_indicator')
+      ->create([
+        'machine' => 'staging',
+        'name' => 'Staging',
+        'url' => 'https://staging.example.com',
+        'weight' => 0,
+        'fg_color' => '#000000',
+        'bg_color' => '#ffff00',
+      ]);
+    $switcher->save();
+
+    $configure_url = Url::fromRoute('environment_indicator.settings')->toString();
+    $selector = '.admin-toolbar__item--environment-indicator a[href="' . $configure_url . '"]';
+
+    $this->drupalLogin($this->privilegedUser);
+    $this->drupalGet('<front>');
+    $this->assertSession()->elementNotExists('css', $selector);
+
+    $admin_user = $this->drupalCreateUser([
+      'access environment indicator',
+      'access navigation',
+      'access administration pages',
+      'administer environment indicator settings',
+    ]);
+    $this->drupalLogin($admin_user);
+    $this->drupalGet('<front>');
+    $this->assertSession()->elementExists('css', $selector);
+  }
+
+  /**
+   * Tests that navigation content is not added for unprivileged users.
+   */
+  public function testNavigationContentForUnprivilegedUser(): void {
+    $this->drupalLogin($this->unprivilegedUser);
+    $this->drupalGet('<front>');
+
+    // Check that the environment indicator is not present.
+    $this->assertSession()->elementNotExists('css', '.admin-toolbar__item--environment-indicator');
+    $this->assertSession()->pageTextNotContains('Test Environment');
+  }
+
+  /**
+   * Tests that anonymous users don't see the environment indicator.
+   */
+  public function testNavigationContentForAnonymousUser(): void {
+    $this->drupalGet('<front>');
+
+    // Check that the environment indicator is not present for anonymous users.
+    $this->assertSession()->elementNotExists('css', '.admin-toolbar__item--environment-indicator');
+    $this->assertSession()->pageTextNotContains('Test Environment');
+  }
+
+  /**
+   * Tests the CSS custom properties are correctly applied.
+   */
+  public function testCssCustomProperties(): void {
+    $this->drupalLogin($this->privilegedUser);
+    $this->drupalGet('<front>');
+
+    // Test that our module's hook returns the expected structure.
+    $navigation_content = \Drupal::moduleHandler()->invoke(
+      'environment_indicator_navigation',
+      'navigation_content_top'
+    );
+
+    $this->assertIsArray($navigation_content);
+    $this->assertArrayHasKey('environment_indicator_wrapper', $navigation_content);
+
+    // Test that the lazy builder service works.
+    $lazy_builder = \Drupal::service('environment_indicator_navigation.lazy_builder');
+    $switcher_links = $lazy_builder->getSwitcherLinks();
+
+    $this->assertIsArray($switcher_links);
+    $this->assertArrayHasKey('#theme', $switcher_links);
+    $this->assertEquals('navigation_menu__environment_indicator_navigation', $switcher_links['#theme']);
+
+    // Test that our environment name appears somewhere in the page.
+    $this->assertSession()->pageTextContains('Test Environment');
+
+    // Test that our module adds the CSS custom properties style tag.
+    $this->assertSession()->elementExists('css', 'style[data-environment-indicator-styles]');
+
+    // Test that the CSS custom properties are present in the style tag.
+    $response = $this->getSession()->getPage()->getContent();
+    $this->assertStringContainsString('--environment-indicator-color: #ffffff', $response);
+    $this->assertStringContainsString('--environment-indicator-background-color: #ff0000', $response);
+  }
+
+  /**
+   * Tests that the environment indicator navigation works without name.
+   */
+  public function testNavigationWithoutEnvironmentName(): void {
+    // Clear the environment name.
+    $environment_config = $this->config('environment_indicator.indicator');
+    $environment_config->set('name', '');
+    $environment_config->save();
+
+    $this->drupalLogin($this->privilegedUser);
+    $this->drupalGet('<front>');
+
+    // Test that our hook still returns structure but with access denied.
+    $navigation_content = \Drupal::moduleHandler()->invoke(
+      'environment_indicator_navigation',
+      'navigation_content_top'
+    );
+
+    // Should still return array structure but access should be false.
+    $this->assertIsArray($navigation_content);
+    $this->assertArrayHasKey('environment_indicator_wrapper', $navigation_content);
+
+    // The access should be denied when no environment name is set.
+    $access = $navigation_content['environment_indicator_wrapper']['#access'];
+    $this->assertFalse($access->isAllowed());
+    $this->assertSession()->pageTextNotContains('Test Environment');
+  }
+
+}
diff --git a/modules/environment_indicator_navigation/tests/src/FunctionalJavascript/JavaScriptInteractionTest.php b/modules/environment_indicator_navigation/tests/src/FunctionalJavascript/JavaScriptInteractionTest.php
