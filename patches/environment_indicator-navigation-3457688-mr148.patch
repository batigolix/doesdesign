+  /**
+   * Tests that proper cache tags and contexts are set.
+   */
+  public function testCacheTagsAndContexts(): void {
+    $this->environmentIndicator
+      ->expects($this->once())
+      ->method('getTitle')
+      ->willReturn('Test Environment');
+
+    $this->environmentIndicator
+      ->expects($this->once())
+      ->method('getLinks')
+      ->willReturn([]);
+
+    $this->environmentIndicatorConfig
+      ->expects($this->once())
+      ->method('get')
+      ->with('name')
+      ->willReturn('test');
+
+    $this->environmentIndicator
+      ->expects($this->once())
+      ->method('getActiveEnvironment')
+      ->willReturn($this->environmentIndicatorConfig);
+
+    $customCacheTags = ['environment_indicator:test', 'config:custom'];
+    $this->environmentIndicator
+      ->expects($this->once())
+      ->method('getCacheTags')
+      ->willReturn($customCacheTags);
+
+    $result = $this->lazyBuilder->getSwitcherLinks();
+
+    $this->assertArrayHasKey('#cache', $result);
+    $this->assertArrayHasKey('tags', $result['#cache']);
+    $this->assertArrayHasKey('contexts', $result['#cache']);
+
+    $expectedTags = Cache::mergeTags([
+      'config:environment_indicator.settings',
+      'config:environment_indicator.indicator',
+    ], $customCacheTags);
+
+    $this->assertEquals($expectedTags, $result['#cache']['tags']);
+    $this->assertEquals(['route', 'user.permissions'], $result['#cache']['contexts']);
+  }
+
+}
