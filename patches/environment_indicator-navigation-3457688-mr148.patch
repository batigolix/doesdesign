+    $this->environmentIndicator
+      ->expects($this->once())
+      ->method('getLinks')
+      ->willReturn($switchers);
+
+    $this->environmentIndicatorConfig
+      ->expects($this->once())
+      ->method('get')
+      ->with('name')
+      ->willReturn('production');
+
+    $this->environmentIndicator
+      ->expects($this->once())
+      ->method('getActiveEnvironment')
+      ->willReturn($this->environmentIndicatorConfig);
+
+    $this->environmentIndicator
+      ->expects($this->once())
+      ->method('getCacheTags')
+      ->willReturn(['environment_indicator:production']);
