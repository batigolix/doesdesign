diff --git a/modules/environment_indicator_navigation/src/Service/LazyBuilder.php b/modules/environment_indicator_navigation/src/Service/LazyBuilder.php
new file mode 100644
index 0000000000000000000000000000000000000000..dce0d5cbac8c013341dac1c0113073f362c3789d
--- /dev/null
+++ b/modules/environment_indicator_navigation/src/Service/LazyBuilder.php
@@ -0,0 +1,90 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\environment_indicator_navigation\Service;
+
+use Drupal\Core\Cache\Cache;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Render\RendererInterface;
+use Drupal\Core\Security\Attribute\TrustedCallback;
+use Drupal\Core\Session\AccountInterface;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+use Drupal\environment_indicator\Service\EnvironmentIndicator;
+
+/**
+ * Lazy builders for the environment indicator navigation module.
+ *
+ * Provides lazy-loaded content for the environment indicator within
+ * Drupal's navigation system, including switcher links and environment
+ * information display.
+ */
+class LazyBuilder {
+
+  use StringTranslationTrait;
+
+  /**
+   * The environment indicator service.
+   *
+   * @var \Drupal\environment_indicator\Service\EnvironmentIndicator
+   */
+  protected EnvironmentIndicator $environmentIndicator;
+
+  /**
+   * Constructs a new LazyBuilder object.
+   *
+   * @param \Drupal\Core\Render\RendererInterface $renderer
+   *   The renderer service.
+   * @param \Drupal\Core\Entity\EntityTypeManagerInterface $entity_type_manager
+   *   The entity type manager.
+   * @param \Drupal\Core\Session\AccountInterface $current_user
+   *   The current user.
+   * @param \Drupal\Core\Config\ConfigFactoryInterface $config_factory
+   *   The config factory.
+   * @param \Drupal\environment_indicator\Service\EnvironmentIndicator $environment_indicator
+   *   The environment indicator service.
+   */
+  public function __construct(
+    protected RendererInterface $renderer,
+    protected EntityTypeManagerInterface $entity_type_manager,
+    protected AccountInterface $current_user,
+    protected ConfigFactoryInterface $config_factory,
+    EnvironmentIndicator $environment_indicator,
+  ) {
+    $this->environmentIndicator = $environment_indicator;
+  }
+
+  /**
+   * Get the switcher links for the environment indicator.
+   *
+   * #lazy_builder callback; builds environment switcher links.
+   *
+   * @return array
+   *   A renderable array of environment indicator links.
+   */
+  #[TrustedCallback]
+  public function getSwitcherLinks() {
+    $items = [
+      'environment_indicator' => [
+        'title' => $this->environmentIndicator->getTitle(),
+        'switchers' => $this->environmentIndicator->getLinks(),
+        'class' => $this->environmentIndicator->getActiveEnvironment()->get('name'),
+        'can_configure' => $this->current_user->hasPermission('administer environment indicator settings'),
+      ],
+    ];
+    return [
+      '#theme' => 'navigation_menu__environment_indicator_navigation',
+      '#menu_name' => 'environment_indicator_navigation',
+      '#items' => $items,
+      '#cache' => [
+        'tags' => Cache::mergeTags([
+          'config:environment_indicator.settings',
+          'config:environment_indicator.indicator',
+        ], $this->environmentIndicator->getCacheTags()),
+        'contexts' => ['route', 'user.permissions'],
+      ],
+    ];
+  }
+
+}
diff --git a/modules/environment_indicator_navigation/templates/navigation-menu--environment-indicator-navigation.html.twig b/modules/environment_indicator_navigation/templates/navigation-menu--environment-indicator-navigation.html.twig
new file mode 100644
index 0000000000000000000000000000000000000000..c1a8d16e20ab31f89842437cfcee6884ca616d84
--- /dev/null
+++ b/modules/environment_indicator_navigation/templates/navigation-menu--environment-indicator-navigation.html.twig
@@ -0,0 +1,107 @@
+{#
+/**
+ * @file
+ * Twig template for the environment indicator navigation in the admin toolbar.
+ *
+ * Attaches the 'environment_indicator/drupal.environment_indicator_navigation'
+ * library. Generates a structured navigation menu item within the Drupal admin
+ * toolbar.
+ *
+ * This template is rendered by the environment_indicator_navigation_content_top
+ * hook.
+ *
+ * Available variables:
+ * - menu_name: The name of the menu being rendered.
+ * - title: The title of the menu block.
+ * - items: An array of menu items to be rendered.
+ *
+ * Logic:
+ * - Sets unique IDs for accessibility and identification purposes.
+ * - Checks if the menu item has children (`switchers`), and renders appropriate
+ *   HTML structure.
+ * - Includes the '@navigation/toolbar-button.html.twig' template for rendering
+ *   individual toolbar buttons.
+ *
+ * Attributes and Classes:
+ * - Assigns various attributes and classes to HTML elements for styling and
+ *   functionality.
+ *
+ * @see environment_indicator_navigation_content_top()
+ */
+#}
+
+{{ attach_library('environment_indicator_navigation/navigation') }}
+{% import _self as menus %}
+{% set menu_heading_id = 'menu--' ~ menu_name|clean_unique_id %}
+{% set item = items|first %}
+{% set item_id = 'navigation-link--environment-indicator'|clean_unique_id %}
+<div class="admin-toolbar__item admin-toolbar__item--environment-indicator">
+  <h4 id="{{ menu_heading_id }}" class="toolbar-block__title visually-hidden focusable">{{ title }}</h4>
+  <ul class="toolbar-block__list" aria-labelledby="{{ menu_heading_id }}">
+    {% if item.switchers is empty %}
+      <li id="{{ item_id }}" class="toolbar-block__list-item">
+        {% include '@navigation/toolbar-button.html.twig' ignore missing with {
+          attributes: create_attribute({ 'href': item.url|render, 'data-drupal-tooltip': item.title, 'data-drupal-tooltip-class': 'admin-toolbar__tooltip' }),
+          icon: { pack_id: 'environment_indicator_navigation', icon_id: 'server' },
+          html_tag: 'a',
+          text: item.title,
+          extra_classes: 'toolbar-button--collapsible toolbar-button--environment-indicator',
+        } only %}
+        {% include 'navigation:toolbar-button' ignore missing with {
+          attributes: create_attribute({ 'href': item.url|render, 'data-drupal-tooltip': item.title, 'data-drupal-tooltip-class': 'admin-toolbar__tooltip' }),
+          icon: { pack_id: 'environment_indicator_navigation', icon_id: 'server' },
+          html_tag: 'a',
+          text: item.title,
+          modifiers: ['collapsible'],
+          extra_classes: ['toolbar-button--environment-indicator'],
+        } only %}
+      </li>
+    {% else %}
+      <li id="{{ item_id }}" class="toolbar-block__list-item toolbar-popover" data-toolbar-popover>
+        {% include '@navigation/toolbar-button.html.twig' ignore missing with {
+          action: true,
+          attributes: create_attribute({'aria-expanded': 'false', 'aria-controls': item_id, 'data-toolbar-popover-control': true, 'style': item.attributes.style}),
+          icon: { pack_id: 'environment_indicator_navigation', icon_id: 'server' },
+          text: item.title,
+          extra_classes: 'toolbar-button--expand--side toolbar-button--collapsible toolbar-popover__control toolbar-button--environment-indicator',
+          has_safe_triangle: TRUE,
+        } only %}
+        {% include 'navigation:toolbar-button' ignore missing with {
+          action: 'Extend'|t,
+          attributes: create_attribute({'aria-expanded': 'false', 'aria-controls': item_id, 'data-toolbar-popover-control': true, 'style': item.attributes.style}),
+          icon: { pack_id: 'environment_indicator_navigation', icon_id: 'server' },
+          text: item.title,
+          modifiers: [
+            'collapsible',
+            'expand--side',
+          ],
+          extra_classes: [
+            'toolbar-popover__control',
+            'toolbar-button--environment-indicator',
+          ],
+          has_safe_triangle: TRUE,
+        } only %}
+        <div class="toolbar-popover__wrapper" data-toolbar-popover-wrapper inert>
+          <span class="toolbar-button toolbar-button--dark toolbar-button--non-interactive toolbar-button--environment-indicator-label">{{ item.title }}</span>
+          <ul class="toolbar-menu toolbar-popover__menu environment-switcher-container">
+            {% for item in  item.switchers %}
+              <li class="toolbar-block__list-item">
+                <a
+                  href="{{ item.url }}"
+                  class="toolbar-button {{ item.attributes.class|join(' ') }}"
+                  {{ create_attribute(item.attributes|without('class')) }}
+                  data-index-text="{{ item.title|first|lower }}"
+                >{{ item.title }}</a>
+              </li>
+            {% endfor %}
+          </ul>
+          {% if item.can_configure %}
+            <a href="{{ path('environment_indicator.settings') }}" class="toolbar-popover__header toolbar-button toolbar-button--dark">
+              {{ 'Configure'|t }}
+            </a>
+          {% endif %}
+        </div>
+      </li>
+    {% endif %}
+  </ul>
+</div>
diff --git a/modules/environment_indicator_navigation/tests/src/Functional/ModuleCompatibilityTest.php b/modules/environment_indicator_navigation/tests/src/Functional/ModuleCompatibilityTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..f807cea561c4627b62161aae95ae78d296682977
--- /dev/null
+++ b/modules/environment_indicator_navigation/tests/src/Functional/ModuleCompatibilityTest.php
@@ -0,0 +1,190 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\environment_indicator_navigation\Functional;
+
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Tests for module compatibility and collision prevention.
+ *
+ * @group environment_indicator_navigation
+ */
+class ModuleCompatibilityTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'environment_indicator',
+    'environment_indicator_navigation',
+    'environment_indicator_toolbar',
+    'navigation',
+    'toolbar',
+  ];
+
+  /**
+   * A user with all necessary permissions.
+   *
+   * @var \Drupal\user\UserInterface
+   */
+  protected $adminUser;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->adminUser = $this->drupalCreateUser([
+      'access environment indicator',
+      'access navigation',
+      'access toolbar',
+      'access administration pages',
+      'administer environment indicator settings',
+    ]);
+
+    // Configure an environment indicator.
+    $environment_config = $this->config('environment_indicator.indicator');
+    $environment_config->set('name', 'Test Environment');
+    $environment_config->set('bg_color', '#00ff00');
+    $environment_config->set('fg_color', '#000000');
+    $environment_config->save();
+  }
+
+  /**
+   * Tests that navigation and toolbar modules can coexist.
+   */
+  public function testNavigationAndToolbarCoexistence(): void {
+    $this->drupalLogin($this->adminUser);
+    $this->drupalGet('<front>');
+
+    // Test that modules are enabled and don't conflict.
+    $moduleHandler = \Drupal::moduleHandler();
+    $this->assertTrue($moduleHandler->moduleExists('navigation'));
+    $this->assertTrue($moduleHandler->moduleExists('toolbar'));
+    $this->assertTrue($moduleHandler->moduleExists('environment_indicator'));
+    $this->assertTrue($moduleHandler->moduleExists('environment_indicator_navigation'));
+    $this->assertTrue($moduleHandler->moduleExists('environment_indicator_toolbar'));
+    // Test that page loads without errors.
+    $this->assertSession()->statusCodeEquals(200);
+  }
+
+  /**
+   * Tests that services don't conflict between modules.
+   */
+  public function testServiceCompatibility(): void {
+    $container = \Drupal::getContainer();
+
+    // Ensure the environment indicator service is available.
+    $this->assertTrue($container->has('environment_indicator.indicator'));
+    $environmentIndicator = $container->get('environment_indicator.indicator');
+    $this->assertInstanceOf(
+      'Drupal\environment_indicator\Service\EnvironmentIndicator',
+      $environmentIndicator
+    );
+
+    // Ensure the navigation lazy builder service is available.
+    $this->assertTrue($container->has('environment_indicator_navigation.lazy_builder'));
+    $lazyBuilder = $container->get('environment_indicator_navigation.lazy_builder');
+    $this->assertInstanceOf(
+      'Drupal\environment_indicator_navigation\Service\LazyBuilder',
+      $lazyBuilder
+    );
+  }
+
+  /**
+   * Tests that CSS doesn't conflict between modules.
+   */
+  public function testCssCompatibility(): void {
+    $this->drupalLogin($this->adminUser);
+    $this->drupalGet('<front>');
+
+    // Test that page loads successfully without CSS conflicts.
+    $this->assertSession()->statusCodeEquals(200);
+
+    // Test that CSS libraries are properly registered.
+    $library_discovery = \Drupal::service('library.discovery');
+    $navigation_library = $library_discovery->getLibraryByName('environment_indicator_navigation', 'navigation');
+    $this->assertNotEmpty($navigation_library);
+  }
+
+  /**
+   * Tests that hooks don't interfere with each other.
+   */
+  public function testHookCompatibility(): void {
+    $this->drupalLogin($this->adminUser);
+
+    // Test that toolbar hook still works.
+    $toolbar_items = \Drupal::moduleHandler()->invokeAll('toolbar');
+    $this->assertArrayHasKey('environment_indicator', $toolbar_items);
+
+    // Test that navigation hook works.
+    $navigation_content = \Drupal::moduleHandler()->invoke(
+      'environment_indicator_navigation',
+      'navigation_content_top'
+    );
+    $this->assertIsArray($navigation_content);
+    $this->assertArrayHasKey('environment_indicator_wrapper', $navigation_content);
+  }
+
+  /**
+   * Tests that theme functions don't conflict.
+   */
+  public function testThemeCompatibility(): void {
+    $theme_registry = \Drupal::service('theme.registry')->get();
+
+    // Ensure navigation theme is registered.
+    $this->assertArrayHasKey(
+      'navigation_menu__environment_indicator_navigation',
+      $theme_registry
+    );
+
+    // Ensure it has the correct base hook.
+    $this->assertEquals(
+      'navigation_menu',
+      $theme_registry['navigation_menu__environment_indicator_navigation']['base hook']
+    );
+  }
+
+  /**
+   * Tests that permissions work correctly across modules.
+   */
+  public function testPermissionCompatibility(): void {
+    // Test that permissions are properly defined.
+    $permission_handler = \Drupal::service('user.permissions');
+    $permissions = $permission_handler->getPermissions();
+
+    $this->assertArrayHasKey('access environment indicator', $permissions);
+    $this->assertArrayHasKey('access navigation', $permissions);
+    $this->assertArrayHasKey('administer environment indicator settings', $permissions);
+  }
+
+  /**
+   * Tests that caching works properly with multiple modules.
+   */
+  public function testCacheCompatibility(): void {
+    $this->drupalLogin($this->adminUser);
+
+    // First request - builds cache.
+    $this->drupalGet('<front>');
+    $this->assertSession()->statusCodeEquals(200);
+
+    // Change environment settings.
+    $environment_config = $this->config('environment_indicator.indicator');
+    $environment_config->set('name', 'Updated Environment');
+    $environment_config->save();
+
+    // Second request - should reflect changes (cache should be invalidated).
+    $this->drupalGet('<front>');
+    $this->assertSession()->pageTextContains('Updated Environment');
+    $this->assertSession()->pageTextNotContains('Test Environment');
+  }
+
+}
