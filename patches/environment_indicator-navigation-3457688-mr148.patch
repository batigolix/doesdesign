--- /dev/null
+++ b/modules/environment_indicator_navigation/tests/src/FunctionalJavascript/JavaScriptInteractionTest.php
@@ -0,0 +1,220 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\environment_indicator_navigation\FunctionalJavascript;
+
+use Drupal\FunctionalJavascriptTests\WebDriverTestBase;
+
+/**
+ * Tests JavaScript functionality and interactions.
+ *
+ * @group environment_indicator_navigation
+ * @group environment_indicator_navigation_js
+ */
+class JavaScriptInteractionTest extends WebDriverTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'environment_indicator',
+    'environment_indicator_navigation',
+    'navigation',
+  ];
+
+  /**
+   * A user with permissions to access the environment indicator.
+   *
+   * @var \Drupal\user\UserInterface
+   */
+  protected $adminUser;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->adminUser = $this->drupalCreateUser([
+      'access environment indicator',
+      'access navigation',
+      'access administration pages',
+    ]);
+
+    // Configure an environment indicator with switchers.
+    $environment_config = $this->config('environment_indicator.indicator');
+    $environment_config->set('name', 'Development');
+    $environment_config->set('bg_color', '#ff0000');
+    $environment_config->set('fg_color', '#ffffff');
+    $environment_config->save();
+
+    // Create some environment indicator entities for switcher functionality.
+    $storage = \Drupal::entityTypeManager()->getStorage('environment_indicator');
+
+    $staging = $storage->create([
+      'machine' => 'staging',
+      'name' => 'Staging',
+      'bg_color' => '#ffff00',
+      'fg_color' => '#000000',
+      'url' => 'https://staging.example.com',
+    ]);
+    $staging->save();
+
+    $production = $storage->create([
+      'machine' => 'production',
+      'name' => 'Production',
+      'bg_color' => '#00ff00',
+      'fg_color' => '#000000',
+      'url' => 'https://production.example.com',
+    ]);
+    $production->save();
+  }
+
+  /**
+   * Tests that navigation popover functionality works.
+   */
+  public function testNavigationPopoverInteraction(): void {
+    $this->drupalLogin($this->adminUser);
+    $this->drupalGet('<front>');
+
+    $page = $this->getSession()->getPage();
+
+    // Check if the environment indicator button exists.
+    $env_button = $page->find('css', '.toolbar-button--environment-indicator');
+    $this->assertNotNull($env_button, 'Environment indicator button should be present');
+
+    // If the button has switchers, it should be clickable to show popover.
+    if ($page->find('css', '[data-toolbar-popover-control]')) {
+      $popover_control = $page->find('css', '[data-toolbar-popover-control]');
+      $this->assertNotNull($popover_control, 'Popover control should exist');
+
+      // Click to open the popover.
+      $popover_control->click();
+
+      // Wait for popover to appear.
+      $this->assertSession()->waitForElement('css', '.toolbar-popover__menu');
+
+      // Check that switcher links are present.
+      $this->assertSession()->elementExists('css', '.toolbar-popover__menu');
+      $switcher_links = $page->findAll('css', '.toolbar-popover__menu a');
+      $this->assertGreaterThan(0, count($switcher_links), 'Switcher links should be present');
+    }
+  }
+
+  /**
+   * Tests that navigation JavaScript doesn't conflict with other modules.
+   */
+  public function testJavaScriptCompatibility(): void {
+    $this->drupalLogin($this->adminUser);
+    $this->drupalGet('<front>');
+
+    $page = $this->getSession()->getPage();
+
+    // Ensure that JavaScript errors don't occur.
+    $logs = $this->getSession()->getDriver()->getWebDriverSession()->log('browser');
+    $js_errors = array_filter($logs, function ($log) {
+      return $log['level'] === 'SEVERE' && strpos($log['message'], 'javascript') !== FALSE;
+    });
+
+    $this->assertEmpty($js_errors, 'No JavaScript errors should occur');
+
+    // Test that environment indicator navigation functionality works.
+    // Check for the environment indicator navigation block.
+    $env_nav_block = $page->find('css', '.admin-toolbar__item--environment-indicator');
+    $this->assertNotNull($env_nav_block, 'Environment indicator navigation block should be present');
+
+    // Check for the specific navigation link with proper ID.
+    $nav_link = $page->find('css', '#navigation-link-environment-indicator');
+    $this->assertNotNull($nav_link, 'Environment indicator navigation link should be present');
+
+    // Test that our JavaScript-enhanced features are working.
+    $env_button = $page->find('css', '.toolbar-button--environment-indicator');
+    if ($env_button) {
+      // Test that the button is interactive and has proper attributes.
+      $this->assertTrue($env_button->isVisible(), 'Environment indicator button should be visible');
+    }
+  }
+
+  /**
+   * Tests accessibility of the navigation component.
+   */
+  public function testAccessibility(): void {
+    $this->drupalLogin($this->adminUser);
+    $this->drupalGet('<front>');
+
+    $page = $this->getSession()->getPage();
+
+    // Check ARIA attributes.
+    $env_button = $page->find('css', '.toolbar-button--environment-indicator');
+    if ($env_button) {
+      // If it's a popover control, it should have proper ARIA attributes.
+      if ($env_button->hasAttribute('data-toolbar-popover-control')) {
+        $this->assertTrue($env_button->hasAttribute('aria-expanded'));
+        $this->assertTrue($env_button->hasAttribute('aria-controls'));
+      }
+    }
+
+    // Check that tooltips are accessible.
+    $tooltip_elements = $page->findAll('css', '[data-drupal-tooltip]');
+    foreach ($tooltip_elements as $element) {
+      $this->assertTrue(
+        $element->hasAttribute('data-drupal-tooltip'),
+        'Tooltip elements should have proper data attributes'
+      );
+    }
+  }
+
+  /**
+   * Tests responsive behavior of the navigation.
+   */
+  public function testResponsiveBehavior(): void {
+    $this->drupalLogin($this->adminUser);
+    $this->drupalGet('<front>');
+
+    // Test desktop view.
+    $this->getSession()->resizeWindow(1200, 800);
+    $this->assertSession()->elementExists('css', '.admin-toolbar__item--environment-indicator');
+
+    // Test tablet view.
+    $this->getSession()->resizeWindow(768, 1024);
+    $this->assertSession()->elementExists('css', '.admin-toolbar__item--environment-indicator');
+
+    // Test mobile view.
+    $this->getSession()->resizeWindow(375, 667);
+
+    // Environment indicator should still be present but might be styled
+    // differently.
+    $page = $this->getSession()->getPage();
+    $env_indicator = $page->find('css', '.admin-toolbar__item--environment-indicator');
+    $this->assertNotNull($env_indicator, 'Environment indicator should be present on mobile');
+  }
+
+  /**
+   * Tests that lazy loading works correctly.
+   */
+  public function testLazyLoading(): void {
+    $this->drupalLogin($this->adminUser);
+    $this->drupalGet('<front>');
+
+    // The lazy builder should have generated content.
+    $this->assertSession()->elementExists('css', '.admin-toolbar__item--environment-indicator');
+
+    // Check that the lazy-loaded content contains expected elements.
+    $page = $this->getSession()->getPage();
+    $env_indicator = $page->find('css', '.admin-toolbar__item--environment-indicator');
+
+    // Should contain the environment name.
+    $this->assertStringContainsString(
+      'Development',
+      $env_indicator->getText(),
+      'Lazy-loaded content should contain environment name'
+    );
+  }
+
+}
