# AI generated
# Extensions (mglaman/phpstan-drupal, phpstan-deprecation-rules) are auto-loaded
# by phpstan/extension-installer — no manual includes required.
parameters:
    level: 2
    paths:
        - web/modules/custom
        - web/themes/custom
    excludePaths:
        - web/themes/custom/*/node_modules/*
        - web/themes/custom/*/vendor/*
        - web/modules/custom/*/vendor/*
        - web/themes/custom/denbei/*
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Procedural preprocess/theme hooks legitimately call \Drupal::.
        -
            message: '#Drupal calls should be avoided in classes#'
            paths:
                - web/themes/custom/*
