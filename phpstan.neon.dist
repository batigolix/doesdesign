# AI generated
# Extensions (mglaman/phpstan-drupal, phpstan-deprecation-rules) are auto-loaded
# by phpstan/extension-installer — no manual includes required.
parameters:
    level: 6
    paths:
        - web/modules/custom
        - web/themes/custom
    excludePaths:
        - web/themes/custom/*/node_modules/*
        - web/themes/custom/*/vendor/*
        - web/modules/custom/*/vendor/*
        - web/themes/custom/denbei/*
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Procedural preprocess/theme hooks legitimately call \Drupal::.
        -
            message: '#Drupal calls should be avoided in classes#'
            paths:
                - web/themes/custom/*
        # Level 6: Drupal form hooks/methods declare narrower array<string, mixed>
        # for readability, but call untyped Drupal core / contrib APIs
        # (parent::validateForm, honeypot::addFormProtection) that take plain
        # `array &$form`. The variance check on by-ref parameters is not fixable
        # without weakening the docblock or patching contrib code.
        -
            identifier: parameterByRef.type
            paths:
                - web/modules/custom/doesdesign_tools/doesdesign_tools.module
                - web/modules/custom/doesdesign_tools/src/Form/ContactForm.php
