<?php

/**
 * @file
 * Theme functions and preprocess hooks for the Shindo theme.
 *
 * AI generated.
 */

use Drupal\block\Entity\Block;
use Drupal\Core\Extension\ThemeSettingsProvider;
use Drupal\file\FileInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page.
 *
 * Adds a page--taxonomy-term--{bundle} suggestion (e.g.
 * page--taxonomy-term--type.html.twig) so per-vocabulary page templates can
 * override the default page layout. Drupal core only ships suggestions with
 * the term id and %, not the vocabulary machine name — bead doesdesign-e2r
 * needs a full-width layout without sidebar_first for the 'type' vocabulary
 * (URL /soort-sieraden/*) to host the portfolio grid view.
 */
function shindo_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() !== 'entity.taxonomy_term.canonical') {
    return;
  }
  $term = $route_match->getParameter('taxonomy_term');
  if (!$term instanceof TermInterface) {
    return;
  }
  $suggestions[] = 'page__taxonomy_term';
  $suggestions[] = 'page__taxonomy_term__' . $term->bundle();
}

/**
 * Implements hook_preprocess_HOOK() for taxonomy-term/type pages.
 *
 * Bead doesdesign-2c4 — the page_title_block is hidden on
 * /soort-sieraden/* via block visibility so the template can render the
 * term name inside a Dopetrope <header class="major"> banner. Core does
 * not populate a `page_title` variable on page templates by default, so
 * we resolve the current taxonomy term here and expose its name for
 * page--taxonomy-term--type.html.twig.
 */
function shindo_preprocess_page__taxonomy_term__type(array &$variables): void {
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if ($term instanceof TermInterface) {
    $variables['page_title'] = $term->getName();
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block.
 *
 * Adds a block--region--{region} suggestion so per-region wrappers
 * (e.g. block--region--sidebar-first.html.twig for Dopetrope .box) can
 * override the default block markup.
 */
function shindo_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $id = $variables['elements']['#id'] ?? NULL;
  if (!$id) {
    return;
  }
  $block = Block::load($id);
  if (!$block) {
    return;
  }
  $region = $block->getRegion();
  $suggestions[] = 'block__region__' . str_replace('-', '_', $region);
}

/**
 * Implements hook_preprocess_HOOK() for html.
 *
 * Injects theme color settings as CSS custom properties on the <html>
 * element. Brand colors (primary/secondary/accent) are converted to
 * HSL components so SCSS can derive hover/muted/border variants via
 * calc() on the lightness.
 */
function shindo_preprocess_html(array &$variables): void {
  $settings = \Drupal::service(ThemeSettingsProvider::class);

  $styles = _shindo_html_build_style_declarations($settings);
  $variables['html_attributes']->setAttribute('style', implode(';', $styles));

  _shindo_html_add_body_classes($variables, $settings);
}

/**
 * Builds the inline style declarations for the <html> element.
 *
 * @param \Drupal\Core\Extension\ThemeSettingsProvider $settings
 *   Theme settings provider.
 *
 * @return string[]
 *   List of "property:value" strings to be joined with ";".
 *
 * @internal
 */
function _shindo_html_build_style_declarations(ThemeSettingsProvider $settings): array {
  $brand_defaults = [
    'color_primary' => '#007acc',
    'color_secondary' => '#626880',
    'color_accent' => '#ef8354',
  ];
  $direct_defaults = [
    'color_background' => '#ffffff',
    'color_text' => '#333333',
  ];

  $styles = [];
  foreach ($brand_defaults as $key => $default) {
    $hex = $settings->getSetting($key) ?: $default;
    [$h, $s, $l] = _shindo_hex_to_hsl($hex);
    $prefix = '--' . str_replace('_', '-', $key);
    $styles[] = "$prefix-h:$h";
    $styles[] = "$prefix-s:$s%";
    $styles[] = "$prefix-l:$l%";
  }
  foreach ($direct_defaults as $key => $default) {
    $hex = $settings->getSetting($key) ?: $default;
    $prefix = '--' . str_replace('_', '-', $key);
    $styles[] = "$prefix:$hex";
  }

  // Shindo primary color (bead doesdesign-c98) — overrides Dopetrope's
  // hardcoded #252122 via var(--shindo-primary) in shindo-colors.css.
  $styles[] = '--shindo-primary:' . ($settings->getSetting('primary_color') ?: '#252122');
  // Shindo footer heading color (bead doesdesign-b2u) — scoped to
  // #footer h1-h6 via var(--shindo-footer-heading) in shindo-colors.css.
  $styles[] = '--shindo-footer-heading:' . ($settings->getSetting('footer_heading_color') ?: '#ffffff');
  // Shindo background color (bead doesdesign-6kj) — overrides
  // Dopetrope's hardcoded #252122 via var(--shindo-bg-color) in
  // shindo-bg.css.
  $styles[] = '--shindo-bg-color:' . ($settings->getSetting('background_color') ?: '#252122');

  return $styles;
}

/**
 * Appends theme-setting driven classes to the <body> element.
 *
 * @param array $variables
 *   The preprocess_html variables array (modified in place).
 * @param \Drupal\Core\Extension\ThemeSettingsProvider $settings
 *   Theme settings provider.
 *
 * @internal
 */
function _shindo_html_add_body_classes(array &$variables, ThemeSettingsProvider $settings): void {
  // Shindo background pattern (bead doesdesign-6kj) — toggled via body
  // class. The actual background-image (bg.png / SVG data URIs / none) is
  // defined per class in shindo-bg.css. Pattern names are validated by
  // the config schema (Choice constraint) so no additional whitelist here.
  $bg_pattern = $settings->getSetting('background_pattern') ?: 'bg';
  $variables['attributes']['class'][] = 'shindo-bg--' . $bg_pattern;

  // Layout body classes — read by SCSS in scss/layout/.
  $container_width = $settings->getSetting('container_width') ?: 'default';
  $sidebar_position = $settings->getSetting('sidebar_position') ?: 'right';
  $show_hero = (bool) $settings->getSetting('show_hero');

  $variables['attributes']['class'][] = 'shindo--container-' . $container_width;
  $variables['attributes']['class'][] = 'shindo--sidebar-' . $sidebar_position;
  if ($show_hero) {
    $variables['attributes']['class'][] = 'shindo--hero-enabled';
  }

  // Dopetrope body classes: mirror the sidebar position and enable the
  // is-preload state (removed by Dopetrope's main.js after DOM ready to
  // trigger initial animations).
  $variables['attributes']['class'][] = 'is-preload';
  $variables['attributes']['class'][] = _shindo_sidebar_body_class($sidebar_position);

  // Body font class — read from theme setting (bead doesdesign-3mx).
  $body_font = $settings->getSetting('body_font') ?: 'source-sans-pro';
  $variables['attributes']['class'][] = 'shindo-font-' . $body_font;
}

/**
 * Maps a sidebar_position setting to the Dopetrope body class.
 *
 * @param string $sidebar_position
 *   One of "none", "left", or any other value (defaults to right-sidebar).
 *
 * @return string
 *   The matching Dopetrope body class.
 *
 * @internal
 */
function _shindo_sidebar_body_class(string $sidebar_position): string {
  return match ($sidebar_position) {
    'none' => 'no-sidebar',
    'left' => 'left-sidebar',
    default => 'right-sidebar',
  };
}

/**
 * Converts a hex color string to HSL components.
 *
 * @param string $hex_string
 *   A hex color code (e.g. "#1b9ae4", "1b9ae4", "#abc").
 *
 * @return array
 *   [hue (0-360), saturation (0-100), lightness (0-100)].
 *
 * @internal
 */
function _shindo_hex_to_hsl(string $hex_string): array {
  $hex_val = trim($hex_string, '#');

  $r0 = $g0 = $b0 = 0;

  if (strlen($hex_val) === 6) {
    $r0 = hexdec($hex_val[0] . $hex_val[1]);
    $g0 = hexdec($hex_val[2] . $hex_val[3]);
    $b0 = hexdec($hex_val[4] . $hex_val[5]);
  }
  elseif (strlen($hex_val) === 3) {
    $r0 = hexdec($hex_val[0] . $hex_val[0]);
    $g0 = hexdec($hex_val[1] . $hex_val[1]);
    $b0 = hexdec($hex_val[2] . $hex_val[2]);
  }

  $r = fdiv($r0, 255);
  $g = fdiv($g0, 255);
  $b = fdiv($b0, 255);

  $c_min = min($r, $g, $b);
  $c_max = max($r, $g, $b);
  $delta = $c_max - $c_min;

  if ($delta == 0) {
    $h = 0;
  }
  else {
    switch ($c_max) {
      case $r:
        $h = fmod((($g - $b) / $delta), 6);
        break;

      case $g:
        $h = (($b - $r) / $delta) + 2;
        break;

      case $b:
        $h = (($r - $g) / $delta) + 4;
        break;

      default:
        $h = 0;
        break;
    }
  }

  $h = round($h * 60);
  if ($h < 0) {
    $h += 360;
  }

  $l = ($c_max + $c_min) / 2;
  $s = $delta == 0 ? 0 : $delta / (1 - abs((2 * $l) - 1));

  return [(int) $h, (int) round($s * 100), (int) round($l * 100)];
}

/**
 * Implements hook_preprocess_HOOK() for media.
 *
 * Removes contextual links from media entities rendered on the frontend
 * (bead doesdesign-mka). Media is edited via parent node/block forms
 * (media_library_edit, bead doesdesign-0ya), so the media-level contextual
 * popup adds no value and interferes with layout. Node/block contextual
 * links remain untouched.
 *
 * Themes cannot use hook_entity_view_alter (ModuleHandler::alter does not
 * dispatch to themes), so this runs at preprocess time. contextual_preprocess
 * places the placeholder in {{ title_suffix.contextual_links }} — unset it
 * there, and also drop the .contextual-region class the preprocess added.
 *
 * AI generated.
 */
function shindo_preprocess_media(array &$variables): void {
  unset($variables['title_suffix']['contextual_links']);
  if (!empty($variables['attributes']['class']) && is_array($variables['attributes']['class'])) {
    $variables['attributes']['class'] = array_values(array_diff(
      $variables['attributes']['class'],
      ['contextual-region']
    ));
  }
}

/**
 * Implements hook_preprocess_HOOK() for node.
 *
 * Bead doesdesign-z1n — builds a `gallery_items` render-array on full-page
 * node.object displays that renders each media entity in `field_media_image`
 * (deltas 1..N — hero delta 0 stays with its default view mode) via a
 * dedicated `gallery` media view mode with the `gallery_square` image style.
 *
 * Rationale: the node view display renders `field_media_image` through
 * `entity_reference_entity_view` with a single view mode. The hero needs the
 * wide `article_hero` style while the grid wants square crops. Twig's
 * `render()` filter cannot switch view modes per-delta and the project does
 * not use twig_tweak, so we build the alternative render array here and let
 * node.html.twig iterate over `gallery_items`.
 *
 * AI generated.
 */
function shindo_preprocess_node(array &$variables): void {
  if (empty($variables['node']) || empty($variables['view_mode'])) {
    return;
  }
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  if ($node->bundle() !== 'object' || !$node->hasField('field_media_image')) {
    return;
  }

  $view_mode = $variables['view_mode'];
  if ($view_mode === 'full') {
    _shindo_node_build_gallery_items($variables, $node);
    return;
  }
  if ($view_mode === 'banner_hero') {
    _shindo_node_add_banner_bg($variables, $node);
  }
}

/**
 * Builds the gallery_items render array for full object node display.
 *
 * @param array $variables
 *   The preprocess_node variables array (modified in place).
 * @param \Drupal\node\NodeInterface $node
 *   The object node.
 *
 * @internal
 */
function _shindo_node_build_gallery_items(array &$variables, NodeInterface $node): void {
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('media');
  $items = [];
  foreach ($node->get('field_media_image')->referencedEntities() as $media) {
    $items[] = $view_builder->view($media, 'gallery');
  }
  $variables['gallery_items'] = $items;
}

/**
 * Computes the banner_ultrawide background URL for banner_hero view mode.
 *
 * Bead doesdesign-xgx — node--object--banner-hero.html.twig renders the
 * hero image as a CSS background instead of a nested <img>.
 *
 * @param array $variables
 *   The preprocess_node variables array (modified in place).
 * @param \Drupal\node\NodeInterface $node
 *   The object node.
 *
 * @internal
 */
function _shindo_node_add_banner_bg(array &$variables, NodeInterface $node): void {
  /** @var \Drupal\Core\Field\Plugin\Field\FieldType\EntityReferenceItem|null $media_field */
  $media_field = $node->get('field_media_image')->first();
  $media = $media_field ? $media_field->entity : NULL;
  if (!$media instanceof MediaInterface || !$media->hasField('field_media_image')) {
    return;
  }
  /** @var \Drupal\Core\Field\Plugin\Field\FieldType\EntityReferenceItem|null $file_field */
  $file_field = $media->get('field_media_image')->first();
  $file = $file_field ? $file_field->entity : NULL;
  if (!$file instanceof FileInterface) {
    return;
  }
  $style = ImageStyle::load('banner_ultrawide');
  if ($style) {
    $variables['banner_bg_url'] = $style->buildUrl($file->getFileUri());
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 *
 * Appends the number of published object nodes per material term to the
 * term name in the browse_by_material view, e.g. "Zilver (12)".
 *
 * Counts are fetched once per request via a single GROUP BY query and
 * cached in a static variable to avoid N+1 queries when rendering the
 * sidebar block.
 */
function shindo_preprocess_views_view_fields(array &$variables): void {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $variables['view'];
  if ($view->id() !== 'browse_by_material') {
    return;
  }
  if (empty($variables['fields']['name'])) {
    return;
  }

  $row = $variables['row'] ?? NULL;
  if (!$row || empty($row->tid)) {
    return;
  }
  $tid = (int) $row->tid;

  $counts = &drupal_static(__FUNCTION__);
  if ($counts === NULL) {
    $connection = \Drupal::database();
    // Count published object nodes per material term in a single query.
    $query = $connection->select('node__field_material', 'fm');
    $query->join('node_field_data', 'n', 'n.nid = fm.entity_id AND n.type = fm.bundle');
    $query->addField('fm', 'field_material_target_id', 'tid');
    $query->addExpression('COUNT(DISTINCT n.nid)', 'count');
    $query->condition('fm.bundle', 'object');
    $query->condition('n.status', 1);
    $query->groupBy('fm.field_material_target_id');
    $counts = $query->execute()->fetchAllKeyed(0, 1);
  }

  $count = (int) ($counts[$tid] ?? 0);

  // Append the count to the rendered term name field.
  $variables['fields']['name']->content = [
    '#markup' => (string) $variables['fields']['name']->content . ' (' . $count . ')',
  ];
}
