{#
/**
 * @file
 * Theme override for the homepage_banner view (bead doesdesign-xgx).
 *
 * Renders a SINGLE random object as a full-width hero section on the
 * homepage. The row template (node--object--banner-hero.html.twig) supplies
 * the actual hero markup with title/subtitle overlay and node link.
 *
 * Supersedes the earlier photoswipe-gallery wrapper (bead doesdesign-3m3);
 * banner is no longer a photoswipe gallery, but a single clickable hero.
 *
 * AI generated.
 *
 * @see template_preprocess_views_view()
 */
#}
{% if rows %}
  <section id="banner" class="hero-banner"{{ attributes }}>
    {{ title_prefix }}
    {{ title }}
    {{ title_suffix }}
    {{ attachment_before }}
    {{ rows }}
    {{ attachment_after }}
  </section>
{% elseif empty %}
  {{ empty }}
{% endif %}
