{#
/**
 * @file
 * Full-width page template for taxonomy term pages in the 'type' vocabulary
 * (URL /soort-sieraden/*). Hosts the portfolio view (bead doesdesign-qdu)
 * without the sidebar_first region so the grid can fill the container.
 *
 * Suggestion is added via shindo_theme_suggestions_page_alter() in
 * shindo.theme (Drupal core does not ship bundle-scoped page suggestions).
 *
 * AI generated (bead doesdesign-e2r).
 */
#}
{%
  set articleClasses = [
  'box',
  'post',
]
%}

<div id="page-wrapper">

  <!-- Header -->
  <section id="header">

    {# Site branding block (see block--system-branding-block.html.twig). #}
    {{ page.header }}

    {# Primary menu block wrapper is <nav id="nav"> (see
       block--system-menu-block--main.html.twig). #}
    {{ page.primary_menu }}

  </section>

  {# Pre-main region — page-level content above the main section, such as
     local tasks tabs, status messages or hero teasers. #}
  {{ page.pre_main }}

  <!-- Main -->
  <section id="main">


    <div class="container">
      <div class="row">
        <div class="col-12">

          <section>
            {# Dopetrope banner-style page title (bead doesdesign-2c4).
               page_title is set in shindo_preprocess_page__taxonomy_term__type()
               because the page_title_block is hidden on /soort-sieraden/* via
               block visibility in block.block.shindo_page_title.yml. #}
            {% if page_title %}
              <header class="major">
                <h2>{{ page_title }}</h2>
              </header>
            {% endif %}

            {{ page.content }}
          </section>
{#          </article>#}
        </div>
      </div>
    </div>
  </section>

  {# Shared footer partial — see templates/partials/footer.html.twig. #}
  {% include '@shindo/partials/footer.html.twig' %}

</div>
