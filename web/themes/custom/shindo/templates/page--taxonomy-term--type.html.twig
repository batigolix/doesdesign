{#
/**
 * @file
 * Full-width page template for taxonomy term pages in the 'type' vocabulary
 * (URL /soort-sieraden/*). Hosts the portfolio view (bead doesdesign-qdu)
 * without the sidebar_first region so the grid can fill the container.
 *
 * Suggestion is added via shindo_theme_suggestions_page_alter() in
 * shindo.theme (Drupal core does not ship bundle-scoped page suggestions).
 *
 * AI generated (bead doesdesign-e2r).
 */
#}
{%
  set articleClasses = [
  'box',
  'post',
]
%}

<div id="page-wrapper">

  <!-- Header -->
  <section id="header">

    {# Site branding block (see block--system-branding-block.html.twig). #}
    {{ page.header }}

    {# Primary menu block wrapper is <nav id="nav"> (see
       block--system-menu-block--main.html.twig). #}
    {{ page.primary_menu }}

  </section>

  {# Pre-main region — page-level content boven de hoofdsectie, zoals
     local tasks tabs, status messages of hero teasers. #}
  {{ page.pre_main }}

  <!-- Main -->
  <section id="main">
    <div class="container">
      <div class="row">
        <div class="col-12">

          <article{{ attributes.addClass(articleClasses) }}>

          {{ page.content }}

          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <section id="footer">
    <div class="container">
      <div class="row">
        <div class="col-8 col-12-medium">
          <section>
            <header>
              <h2>Recent nieuws</h2>
            </header>
            {# Drupal footer_col_1 region — renders the "news" view
               block_footer_dates display as <ul class="dates"> with the
               five most recent article nodes. #}
            {{ page.footer_col_1 }}
          </section>
        </div>
        <div class="col-4 col-12-medium">

          {# Drupal footer_col_2 region — each block renders as <section class="box">
             via templates/block--region--footer-col-2.html.twig, matching the
             Dopetrope featured-image + header + body + button pattern. #}
          {{ page.footer_col_2 }}

        </div>
        <div class="col-4 col-6-medium col-12-small">
          {# Drupal footer_col_3 region — bewerkbaar link-lijst blok. #}
          {{ page.footer_col_3 }}
        </div>
        <div class="col-4 col-6-medium col-12-small">
          {# Drupal footer_col_4 region — bewerkbaar link-lijst blok. #}
          {{ page.footer_col_4 }}
        </div>
        <div class="col-4 col-12-medium">

          {# Drupal footer_col_5 region — social/contact blocks (social icons,
             contact info) placed via block config. Replaces the Dopetrope
             hardcoded "Vitae tempor lorem" column. #}
          {{ page.footer_col_5 }}

        </div>
        <div class="col-12">

          {# Drupal post_footer region — configurable Colofon block containing
             the site's copyright / attribution links. Edit via /admin/content/block. #}
          <div id="copyright">
            {{ page.post_footer }}
          </div>

        </div>
      </div>
    </div>
  </section>

</div>
