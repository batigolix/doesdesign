{#
/**
 * @file
 * Theme override for a block placed in the footer_col2 region.
 *
 * AI generated. Wraps in <section class="box"> so Dopetrope's .box CSS
 * applies to Drupal-rendered footer column 2 blocks. Renders the
 * featured image above the header (Dopetrope "About this site"
 * pattern), field_title as the visible <h2>, body content, and
 * field_button links as .button in a <footer>.
 */
#}
{% set display_title = content.field_title|render|striptags|trim ?: label %}
<section{{ attributes.addClass('') }}>
  {{ title_prefix }}
  {% if display_title %}
    <header><h2>{{ display_title }}</h2></header>
  {% endif %}
  {{ title_suffix }}
  {% if content.field_media_image|render %}
    {% set media_render = content.field_media_image %}
    {% if media_render[0] %}
      {% set media_render = media_render|merge({0: media_render[0]|merge({'#view_mode': 'small_block'})}) %}
    {% endif %}
    <span class="image featured">{{ media_render }}</span>
  {% endif %}
  {{ content|without('field_media_image', 'field_image', 'field_title', 'field_button') }}
  {% if content.field_button|render|trim %}
    <footer>
      <ul class="actions">
        {% for item in content.field_button['#items'] %}
          <li><a href="{{ item.getUrl() }}" class="button">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
    </footer>
  {% endif %}
</section>
