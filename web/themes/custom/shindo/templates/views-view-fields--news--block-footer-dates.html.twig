{#
/**
 * @file
 * Theme override for a "news" / "block_footer_dates" view row.
 *
 * AI generated. Emits Dopetrope's <li> pattern:
 *   <span class="date">Mon <strong>DD</strong></span>
 *   <h3><a href="…">Title</a></h3>
 *   <p>Body summary</p>
 * The month/day come from the node's created timestamp via row._entity;
 * title and body use the rendered view fields (which honor the view's
 * link-to-entity + trim settings).
 */
#}
{% set node = row._entity %}
<span class="date">{{ node.getCreatedTime|date('M') }} <strong>{{ node.getCreatedTime|date('j') }}</strong></span>
<h3>{{ fields.title.content }}</h3>
<p>{{ fields.body.content }}</p>
