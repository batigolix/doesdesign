{#
/**
 * @file
 * AI generated
 * Theme override for the "footer" menu — flat inline list.
 */
#}
{% import _self as menus %}

{{ menus.menu_links(items, attributes.addClass('menu', 'menu--footer'), 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes }}>
    {% else %}
      <ul class="menu menu--footer-sub">
    {% endif %}
    {% for item in items %}
      {%
        set classes = [
          'menu-item',
          item.in_active_trail ? 'menu-item--active-trail',
        ]
      %}
      <li{{ item.attributes.addClass(classes) }}>
        {{ link(item.title, item.url) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
