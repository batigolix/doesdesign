{#
/**
 * @file
 * AI generated
 * Theme override to display a single page.
 *
 * Regions used (13, matching shindo.info.yml):
 * - header, primary_menu, secondary_menu, help
 * - pre_main, content, sidebar_first, sidebar_second
 * - footer_col1, footer_col2, footer_col3, footer, post_footer
 *
 * Page title, breadcrumb, tabs and action links are provided by blocks
 * that admins place in the appropriate regions (typically `header`
 * or `pre_main`) — not hardcoded here.
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}
<div class="layout-container{% if is_front %} is-front{% endif %}">

  <header class="layout-header" role="banner">
    {{ page.header }}
  </header>

  {% if page.primary_menu %}
    <nav class="layout-primary-menu" aria-label="{{ 'Primary menu'|t }}">
      {{ page.primary_menu }}
    </nav>
  {% endif %}

  {% if page.secondary_menu %}
    <nav class="layout-secondary-menu" aria-label="{{ 'Secondary menu'|t }}">
      {{ page.secondary_menu }}
    </nav>
  {% endif %}

  {{ page.pre_main }}

  <main class="layout-main" role="main">
    <a id="main-content" tabindex="-1"></a>

    {{ page.help }}

    <div class="layout-content">
      {{ page.content }}
    </div>

    {% if page.sidebar_first %}
      <aside class="layout-sidebar layout-sidebar--first" role="complementary">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}

    {% if page.sidebar_second %}
      <aside class="layout-sidebar layout-sidebar--second" role="complementary">
        {{ page.sidebar_second }}
      </aside>
    {% endif %}
  </main>

  {% set has_footer_cols = page.footer_col1 or page.footer_col2 or page.footer_col3 %}
  {% if has_footer_cols or page.footer or page.post_footer %}
    <div class="layout-footer-wrapper">
      <footer class="layout-footer" role="contentinfo">
        {% if has_footer_cols %}
          <div class="layout-footer-cols">
            {% if page.footer_col1 %}
              <div class="layout-footer-col layout-footer-col--1">{{ page.footer_col1 }}</div>
            {% endif %}
            {% if page.footer_col2 %}
              <div class="layout-footer-col layout-footer-col--2">{{ page.footer_col2 }}</div>
            {% endif %}
            {% if page.footer_col3 %}
              <div class="layout-footer-col layout-footer-col--3">{{ page.footer_col3 }}</div>
            {% endif %}
          </div>
        {% endif %}
        {% if page.footer %}
          <div class="layout-footer-bottom">{{ page.footer }}</div>
        {% endif %}
      </footer>
      {% if page.post_footer %}
        <div class="layout-post-footer">{{ page.post_footer }}</div>
      {% endif %}
    </div>
  {% endif %}

</div>
