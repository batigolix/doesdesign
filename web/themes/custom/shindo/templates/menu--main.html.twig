{#
/**
 * @file
 * Theme override for the "main" menu — matches Dopetrope's #nav > ul > li
 * markup so #nav-styling in main.css applies directly.
 *
 * AI generated. Based on alpaca (metalartcreations).
 *
 * Notes:
 * - Top-level <ul> has no class (Dopetrope selector is `#nav > ul`).
 * - Active trail items get the .current class Dopetrope expects.
 */
#}
{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    <ul>
    {% for item in items %}
      {%
        set classes = [
          item.is_expanded ? 'menu-item--expanded',
          item.is_collapsed ? 'menu-item--collapsed',
          item.in_active_trail ? 'current',
        ]|filter(v => v)
      %}
      <li{% if classes|length %} class="{{ classes|join(' ') }}"{% endif %}>
        {{ link(item.title, item.url) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
