{#
/**
 * @file
 * Front page template — Dopetrope demo homepage layout.
 *
 * Based on https://html5up.net/uploads/demos/dopetrope/index.html:
 * - Banner ("id=banner") and Intro featurettes ("class=features") live inside
 *   the header <section> — i.e. above the main content.
 * - Main splits content + sidebar_first like the default page template.
 * - Footer is identical to page.html.twig.
 *
 * Banner slot: page.pre_main region ("Banner" in shindo.info.yml). Place a
 * block here with markup <section id="banner"><header><h2>…</h2><p>…</p></header></section>
 * to reuse the Dopetrope hero.
 *
 * Features: three configurable blocks in the intro_col1/2/3 regions (see
 * shindo.info.yml). Basic Blocks are placed via block.block.shindo_intro_col*.yml
 * and are visible on <front> only. The site owner edits the content via
 * /admin/content/block.
 *
 * AI generated (bead doesdesign-pil, ep5).
 */
#}
{%
  set articleClasses = [
  'box',
  'post',
]
%}

<div id="page-wrapper">

  <!-- Header -->
  <section id="header">

    {# Site branding block (see block--system-branding-block.html.twig). #}
    {{ page.header }}

    {# Primary menu block wrapper is <nav id="nav"> (see
       block--system-menu-block--main.html.twig). #}
    {{ page.primary_menu }}

    {# Banner — Drupal pre_main region ("Banner" label). Place a single
       block here with the Dopetrope hero markup. Example:
       <section id="banner"><header><h2>Title</h2><p>Subtitle</p></header></section>
    #}
    {{ page.pre_main }}

    {# Intro featurettes — Dopetrope "id=intro" with three columns.
       Content is managed via the intro_col1/2/3 regions (Basic Blocks). #}
    <section id="intro" class="container">
      <div class="row">
        <div class="col-4 col-12-medium first">
          {{ page.intro_col1 }}
        </div>
        <div class="col-4 col-12-medium middle">
          {{ page.intro_col2 }}
        </div>
        <div class="col-4 col-12-medium last">
          {{ page.intro_col3 }}
        </div>
      </div>
    </section>

  </section>

  <!-- Main -->
  <section id="main">
    <div class="container">
      <div class="row">
        <div class="col-12">

{#          <article{{ attributes.addClass(articleClasses) }}>#}

          {{ page.content }}

{#          </article>#}
        </div>
      </div>
    </div>
  </section>

  {# Shared footer partial — see templates/partials/footer.html.twig. #}
  {% include '@shindo/partials/footer.html.twig' %}

</div>
