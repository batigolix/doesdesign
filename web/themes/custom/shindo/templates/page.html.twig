{%
  set articleClasses = [
  'box',
  'post',
]
%}

<div id="page-wrapper">

  <!-- Header -->
  <section id="header">

    {# Site branding block (see block--system-branding-block.html.twig). #}
    {{ page.header }}

    {# Primary menu block wrapper is <nav id="nav"> (see
       block--system-menu-block--main.html.twig). #}
    {{ page.primary_menu }}

  </section>

  {# Pre-main region — page-level content boven de hoofdsectie, zoals
     local tasks tabs, status messages of hero teasers. #}
  {{ page.pre_main }}

  <!-- Main -->
  <section id="main">
    <div class="container">
      <div class="row">
        <div class="col-8 col-12-medium">

          <article{{ attributes.addClass(articleClasses) }}>

          {{ page.content }}

          </article>
        </div>
        <div class="col-4 col-12-medium">

          {# Drupal sidebar_first region — each block renders as <section class="box">
             via templates/block--region--sidebar-first.html.twig.
             Blocks with a field_image (image field) render Dopetrope's
             featured-image pattern above the header. #}
          {{ page.sidebar_first }}

        </div>
      </div>
    </div>
  </section>

  {# Shared footer partial — see templates/partials/footer.html.twig. #}
  {% include '@shindo/partials/footer.html.twig' %}

</div>
