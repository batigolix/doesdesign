{#
/**
 * @file
 * Shared footer partial included from page.html.twig,
 * page--front.html.twig, and page--taxonomy-term--type.html.twig.
 *
 * Renders the Dopetrope-style footer with five column regions
 * (footer_row1_col1..col2, footer_row2_col1..col3) plus a full-width
 * post_footer / copyright row.
 *
 * AI generated (bead doesdesign-5xv).
 */
#}
<!-- Footer -->
<section id="footer">
  <div class="container">
    <div class="row">
      <div class="col-8 col-12-medium">
        <section>
          <header>
            <h2>Recent nieuws</h2>
          </header>
          {# Drupal footer_row1_col1 region — renders the "news" view
             block_footer_dates display as <ul class="dates"> with the
             five most recent article nodes. #}
          {{ page.footer_row1_col1 }}
        </section>
      </div>
      <div class="col-4 col-12-medium">

        {# Drupal footer_row1_col2 region — each block renders as <section class="box">
           via templates/block--region--footer-row1-col2.html.twig, matching the
           Dopetrope featured-image + header + body + button pattern. #}
        {{ page.footer_row1_col2 }}

      </div>
      <div class="col-4 col-6-medium col-12-small">
        {# Drupal footer_row2_col1 region — bewerkbaar link-lijst blok. #}
        {{ page.footer_row2_col1 }}
      </div>
      <div class="col-4 col-6-medium col-12-small">
        {# Drupal footer_row2_col2 region — bewerkbaar link-lijst blok. #}
        {{ page.footer_row2_col2 }}
      </div>
      <div class="col-4 col-12-medium">

        {# Drupal footer_row2_col3 region — social/contact blocks (social icons,
           contact info) placed via block config. Replaces the Dopetrope
           hardcoded "Vitae tempor lorem" column. #}
        {{ page.footer_row2_col3 }}

      </div>
      <div class="col-12">

        {# Drupal post_footer region — configurable Colofon block containing
           the site's copyright / attribution links. Edit via /admin/content/block. #}
        <div id="copyright">
          {{ page.post_footer }}
        </div>

      </div>
    </div>
  </div>
</section>
