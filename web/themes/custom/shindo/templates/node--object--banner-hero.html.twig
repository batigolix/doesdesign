{#
/**
 * @file
 * Theme override for object nodes rendered in the `banner_hero` view mode
 * (bead doesdesign-xgx).
 *
 * Renders the hero image as a CSS background on <a>, mirroring Dopetrope's
 * approach where the banner image is decorative (via background-image on
 * body). Image is intentionally not in the DOM: the object title fully
 * describes the artwork, so an aria-label on the link is sufficient for
 * screen readers.
 *
 * `banner_bg_url` is set by shindo_preprocess_node() using image style
 * `hero_wide`.
 *
 * AI generated.
 */
#}
{% set title_str = node.getTitle() %}
{# bead doesdesign-dlan — `banner_bg_url` is inserted inside a CSS `url()`
   string context. Twig's default autoescape only handles the HTML attribute
   context, not the nested CSS one, so a URL with special characters could
   break out of the string. `|escape('css')` percent-encodes anything unsafe
   for that context. #}
<a href="{{ url }}" class="banner-link" rel="bookmark" aria-label="{{ title_str }}"
   {%- if banner_bg_url %} style="background-image: url('{{ banner_bg_url|escape('css') }}');"{% endif %}>
  <header>
    <h2>{{ label }}</h2>
    {% set subtitle = content.field_subtitle|render|striptags|trim %}
    {% if subtitle %}
      <p>{{ subtitle }}</p>
    {% endif %}
  </header>
</a>
