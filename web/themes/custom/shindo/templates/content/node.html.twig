{#
/**
 * @file
 * Theme override to display a node.
 *
 * AI generated.
 *
 * Full-view puts the featured image above the title (Dopetrope layout).
 * Teaser view mode has its own override in node--*--teaser.html.twig.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
<article{{ attributes.addClass(classes) }}>

  {% if view_mode == 'full' %}
    {# Featured image on top, full-width above the title. Render only the
       first item when field_media_image is multi-value. #}
    {% if content.field_media_image|render %}
      <div class="node__featured-image">
        {{ content.field_media_image.0 }}
      </div>
    {% endif %}

    {{ title_prefix }}
    <h1{{ title_attributes.addClass('node__title') }}>{{ label }}</h1>
    {{ title_suffix }}

    <div class="node__content">
      {{ content|without('field_media_image', 'comments', 'links') }}
    </div>
  {% else %}
    {{ title_prefix }}
    <h2{{ title_attributes }}>
      <a href="{{ url }}">{{ label }}</a>
    </h2>
    {{ title_suffix }}

    <div class="node__content">
      {{ content|without('comments', 'links') }}
    </div>
  {% endif %}

  {{ content.comments }}

</article>
