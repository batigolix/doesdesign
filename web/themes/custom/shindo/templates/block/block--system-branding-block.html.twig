{#
/**
 * @file
 * AI generated
 * Theme override for the site branding block (logo + name + slogan).
 *
 * Available variables:
 * - site_logo: Logo path (empty when disabled).
 * - site_name: Site name (empty when disabled).
 * - site_slogan: Slogan (empty when disabled).
 */
#}
{% extends "block.html.twig" %}

{% block content %}
  <div class="site-branding">
    {% if site_logo %}
      <a href="{{ path('<front>') }}" class="site-branding__logo" title="{{ 'Home'|t }}" rel="home">
        <img src="{{ site_logo }}" alt="{{ 'Home'|t }}" />
      </a>
    {% endif %}
    {% if site_name or site_slogan %}
      <div class="site-branding__text">
        {% if site_name %}
          <h1 class="site-branding__name">
            <a href="{{ path('<front>') }}" title="{{ 'Home'|t }}" rel="home">{{ site_name }}</a>
          </h1>
        {% endif %}
        {% if site_slogan %}
          <p class="site-branding__slogan">{{ site_slogan }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endblock %}
