{#
/**
 * @file
 * Theme override to display a node.
 *
 * AI generated
 *
 * Renders the Dopetrope "featured image + title" pattern for full node
 * displays: `field_media_image.0` is placed inside
 * `<span class="image featured">` above the `<h1 class="node__title">`,
 * mirroring the pattern originally introduced in bead it0 and lost during
 * the shindo theme restructure (see bead doesdesign-f0g).
 *
 * The `<h1>` and optional `field_subtitle` are wrapped in a `<header>`
 * matching Dopetrope's article-header pattern (see bead doesdesign-nbl).
 *
 * For non-page view modes (teasers, search results, embeds) the title
 * falls back to an `<h2>` link so listing pages keep their original
 * markup.
 *
 * @see template_preprocess_node()
 */
#}
{%
  set classes = [
    'node--type-' ~ node.bundle|clean_class,
    'node--view-mode-' ~ view_mode|clean_class,
  ]
%}

<div{{ attributes.addClass(classes) }}>

  {% if page %}
    {% if content.field_media_image.0 %}
      <span class="image featured">
        {{ content.field_media_image.0 }}
      </span>
    {% endif %}

    <header>
      {{ title_prefix }}
      <h1{{ title_attributes.addClass('node__title') }}>{{ label }}</h1>
      {{ title_suffix }}
      {% set subtitle = content.field_subtitle|render|striptags|trim %}
      {% if subtitle %}
        <p class="node__subtitle">{{ subtitle }}</p>
      {% endif %}
    </header>

    {% if display_submitted %}
      <footer class="node__meta">
        {{ author_picture }}
        <div{{ author_attributes.addClass('node__submitted') }}>
          {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
          {{ metadata }}
        </div>
      </footer>
    {% endif %}

    <div{{ content_attributes.addClass('node-content') }}>
      {{ content|without('field_media_image', 'field_subtitle', 'comments', 'links') }}
    </div>
  {% else %}
    {{ title_prefix }}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
    {{ title_suffix }}

    {% if display_submitted %}
      <footer class="node__meta">
        {{ author_picture }}
        <div{{ author_attributes.addClass('node__submitted') }}>
          {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
          {{ metadata }}
        </div>
      </footer>
    {% endif %}

    <div{{ content_attributes.addClass('node-content') }}>
      {{ content|without('comments', 'links') }}
    </div>
  {% endif %}

</div>
