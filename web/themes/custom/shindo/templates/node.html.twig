{#
/**
 * @file
 * Theme override to display a node.
 *
 * AI generated
 *
 * Renders a Dopetrope-style article page for full node displays:
 * a hero image (delta 0 of `field_media_image`) above the `<header>`,
 * then the `<h1 class="node__title">` and optional `field_subtitle`,
 * followed by the body/other fields, and finally a two-column
 * responsive photoswipe gallery grid with square thumbnails containing
 * the remaining deltas (1..N) of `field_media_image` (see beads
 * doesdesign-1f5, doesdesign-9tu, doesdesign-a8f, doesdesign-z1n — the
 * hero re-instates the classic Dopetrope featured image while the grid
 * keeps multi-value objects like "Gesp Processor" browsable without
 * rendering delta 0 twice. The grid renders each media entity via the
 * `gallery` media view mode — a dedicated photoswipe formatter using
 * the `gallery_square` image style — built as `gallery_items` in
 * shindo_preprocess_node()).
 *
 * The photoswipe field formatter already wraps each `<img>` in an
 * `<a class="photoswipe" href="...">` element (lightbox trigger); by
 * adding the `photoswipe-gallery` class to the wrapping row (same
 * pattern as bead doesdesign-3m3 for the homepage banner view) the
 * Photoswipe module groups all deltas into ONE gallery with
 * next/prev navigation and a "1/N" counter.
 *
 * For non-page view modes (teasers, search results, embeds) the title
 * falls back to an `<h2>` link so listing pages keep their original
 * markup.
 *
 * @see template_preprocess_node()
 */
#}
{%
  set classes = [
    'node--type-' ~ node.bundle|clean_class,
    'node--view-mode-' ~ view_mode|clean_class,
  ]
%}

<div{{ attributes.addClass(classes) }}>

  {% if page %}
    {% if content.field_media_image['#items'] is not empty %}
        {{ content.field_media_image.0 }}
    {% endif %}

    <header>
      {{ title_prefix }}
      <h1{{ title_attributes.addClass('node__title') }}>{{ label }}</h1>
      {{ title_suffix }}
      {% set subtitle = content.field_subtitle|render|striptags|trim %}
      {% if subtitle %}
        <p class="node__subtitle">{{ subtitle }}</p>
      {% endif %}
    </header>

    {% if display_submitted %}
      <footer class="node__meta">
        {{ author_picture }}
        <div{{ author_attributes.addClass('node__submitted') }}>
          {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
          {{ metadata }}
        </div>
      </footer>
    {% endif %}

    <div{{ content_attributes.addClass('node-content') }}>
      {{ content|without('field_media_image', 'field_subtitle', 'comments', 'links') }}
    </div>

    {% if gallery_items is defined and gallery_items|length > 0 %}
      <div class="row photoswipe-gallery node__gallery">
        {% for gallery_item in gallery_items %}
          <div class="col-6 col-12-medium">
            {{ gallery_item }}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  {% else %}
    {{ title_prefix }}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
    {{ title_suffix }}

    {% if display_submitted %}
      <footer class="node__meta">
        {{ author_picture }}
        <div{{ author_attributes.addClass('node__submitted') }}>
          {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
          {{ metadata }}
        </div>
      </footer>
    {% endif %}

    <div{{ content_attributes.addClass('node-content') }}>
      {{ content|without('comments', 'links') }}
    </div>
  {% endif %}

</div>
