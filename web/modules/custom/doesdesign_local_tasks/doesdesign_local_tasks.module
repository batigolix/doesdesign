<?php

/**
 * @file
 * Contains doesdesign_local_tasks.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\block\Entity\Block;

/**
 * Restore local_tasks_block visibility across all render children in a region.
 *
 * @param array<string, mixed> $region
 *   A single page region render array, by reference.
 */
function _doesdesign_local_tasks_restore_region(array &$region): void {
  foreach ($region as $child_key => &$child) {
    if (is_array($child) && !str_starts_with((string) $child_key, '#')) {
      _doesdesign_local_tasks_unset_access($child);
    }
  }
}

/**
 * Unset `#access` on a render child if it targets a local_tasks_block.
 *
 * Helper for doesdesign_local_tasks_preprocess_page() to keep the main
 * hook below phpmd's cyclomatic/NPath thresholds. Uses early returns so
 * each guard adds only one path.
 *
 * @param array<string, mixed> $child
 *   A single render array child from a page region, by reference.
 */
function _doesdesign_local_tasks_unset_access(array &$child): void {
  if (!isset($child['#lazy_builder'][1][0])) {
    return;
  }
  if (($child['#access'] ?? NULL) !== FALSE) {
    return;
  }
  $block_id = $child['#lazy_builder'][1][0];
  if (!is_string($block_id)) {
    return;
  }
  $block = Block::load($block_id);
  if (!$block || $block->getPluginId() !== 'local_tasks_block') {
    return;
  }
  unset($child['#access']);
}

/**
 * Implements hook_help().
 */
function doesdesign_local_tasks_help(string $route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    // Main module help for the doesdesign_local_tasks module.
    case 'help.page.doesdesign_local_tasks':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Fancy local tasks module') . '</p>';
      return $output;

    default:
      return '';
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * Attaches the frontend local tasks library. Also restores rendering of the
 * local_tasks_block placements on the front-end (bead doesdesign-b2j2).
 *
 * Drupal core's Navigation module unconditionally sets
 * `$build['#access'] = FALSE` on every local_tasks_block plugin when the
 * current user has the 'access navigation' permission and the top bar has a
 * `page_actions` item (see
 * \Drupal\navigation\NavigationRenderer::removeLocalTasks() and
 * \Drupal\navigation\Hook\NavigationHooks::blockBuildLocalTasksBlockAlter()).
 * That prevents duplication with the admin top bar — but it also removes
 * the frontend local tasks block, because the hook does not check the
 * active theme. On uid=1 (or any user with 'access navigation') this hides
 * the tabs on every canonical entity page.
 *
 * The block-build alter runs too early to override reliably (module
 * weights and attribute-based hooks make ordering fragile), so we
 * intercept at preprocess_page (which runs after the whole page render
 * tree is assembled but before regions render) and unset `#access` on any
 * local_tasks_block placement in the current page. On admin routes the
 * navigation top bar continues to render local tasks as usual.
 *
 * @phpstan-param array<string, mixed> $variables
 */
function doesdesign_local_tasks_preprocess_page(array &$variables): void {
  $is_admin_route = \Drupal::service('router.admin_context')->isAdminRoute();
  if ($variables['logged_in'] && !$is_admin_route) {
    $variables['#attached']['library'][] = 'doesdesign_local_tasks/doesdesign-local-tasks';
  }
  if ($is_admin_route) {
    return;
  }
  // Undo navigation module's `#access = FALSE` marker on local_tasks_block
  // placements across all regions so the front-end tabs render again.
  foreach ($variables['page'] as $region_key => &$region) {
    if (is_array($region) && !str_starts_with((string) $region_key, '#')) {
      _doesdesign_local_tasks_restore_region($region);
    }
  }
  unset($region);
}

/**
 * Implements hook_theme().
 *
 * Registers a theme suggestion template for front-end local tasks.
 *
 * @phpstan-param array<string, mixed> $existing
 * @phpstan-return array<string, mixed>
 */
function doesdesign_local_tasks_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'menu_local_tasks__frontend' => [
      'variables' => [
        'primary' => [],
        'secondary' => [],
      ],
      'base hook' => 'menu_local_tasks',
      'path' => \Drupal::service('extension.list.module')->getPath('doesdesign_local_tasks') . '/templates',
      'template' => 'menu-local-tasks--frontend',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_menu_local_tasks_alter().
 *
 * @phpstan-param array<int, string> $suggestions
 * @phpstan-param array<string, mixed> $variables
 */
function doesdesign_local_tasks_theme_suggestions_menu_local_tasks_alter(array &$suggestions, array $variables): void {
  if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
    $suggestions[] = 'menu_local_tasks__frontend';
  }
}
