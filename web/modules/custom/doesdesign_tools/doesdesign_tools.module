<?php

/**
 * @file
 * Contains doesdesign_tools.module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\Core\Link;

/**
 * Implements hook_theme().
 *
 * @phpstan-return array<string, array<string, mixed>>
 */
function doesdesign_tools_theme(): array {
  return [
    'slideshow_block' => [
      'variables' => [
        'slides' => [],
      ],
    ],
  ];
}

/**
 * Sends mail.
 *
 * @param string $key
 *   The mail template key.
 * @param array<string, mixed> $message
 *   The message array, altered by reference.
 * @param array<string, mixed> $params
 *   Parameters supplied by the caller.
 */
function doesdesign_tools_mail(string $key, array &$message, array $params): void {
  $options = [
    'langcode' => $message['langcode'],
  ];
  switch ($key) {
    case 'doesdesign_tools_mail':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('E-mail van doesdesign.nl: @subject', ['@subject' => $params['subject']], $options);
      $message['body'][] = $params['message'];
      break;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * @phpstan-param array<string, mixed> $form
 */
function doesdesign_tools_form_contact_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {

  \Drupal::service('honeypot')->addFormProtection($form, $form_state, [
    'honeypot',
    'time_restriction',
  ]);
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * @phpstan-param array<string, mixed> $form
 */
function doesdesign_tools_form_search_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  unset($form['help_link']);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 *
 * Renames the "Promoted to front page" checkbox on object nodes to
 * "Tonen op voorpagina" to better reflect its role in the homepage banner.
 *
 * @phpstan-param array<string, mixed> $form
 */
function doesdesign_tools_form_node_object_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (isset($form['promote']['widget']['value']['#title'])) {
    $form['promote']['widget']['value']['#title'] = t('Tonen op voorpagina');
  }
}

/**
 * Preprocesses node.
 *
 * @param array<string, mixed> $variables
 *   Template variables, altered by reference.
 */
function doesdesign_tools_preprocess_node(array &$variables): void {
  $type = $variables['node']->getType();
  if ($type == "object") {
    $label = $variables['node']->label();
    $nid = $variables['node']->id();
    $subject = "$label - $nid";
    $url = Url::fromUri('internal:/contact', [
      'query' => ['subject' => $subject],
    ]);
    $link = Link::fromTextAndUrl(t('Stel een vraag over dit sieraad'), $url)
      ->toString();
    $variables['content']['ask'] = [
      '#markup' => $link,
      '#weight' => 666,
      '#prefix' => '<p>',
      '#suffix' => '</p>',
    ];
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for taxonomies.
 *
 * @phpstan-param array<int, string> $suggestions
 * @phpstan-param array<string, mixed> $vars
 */
function doesdesign_tools_theme_suggestions_taxonomy_term_alter(array &$suggestions, array $vars, string $hook): void {

  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $vars['elements']['#taxonomy_term'];
  $suggestions[] = 'taxonomy_term__' . $term->bundle() . '__' . $vars['elements']['#view_mode'];
  $suggestions[] = 'taxonomy_term__' . $vars['elements']['#view_mode'];
}
